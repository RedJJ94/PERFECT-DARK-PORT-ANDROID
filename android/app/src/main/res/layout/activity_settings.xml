<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a1a2e">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Configurações"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="32dp"/>

    <!-- VIDEO SETTINGS -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Vídeo"
        android:textColor="#4a9eff"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <CheckBox
        android:id="@+id/checkFullscreen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tela Cheia"
        android:textColor="#FFFFFF"
        android:buttonTint="#4a9eff"
        android:layout_marginBottom="8dp"/>

    <CheckBox
        android:id="@+id/checkVsync"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="VSync"
        android:textColor="#FFFFFF"
        android:buttonTint="#4a9eff"
        android:layout_marginBottom="8dp"/>

    <CheckBox
        android:id="@+id/checkDisplayFPS"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mostrar FPS"
        android:textColor="#FFFFFF"
        android:buttonTint="#4a9eff"
        android:layout_marginBottom="8dp"/>

    <CheckBox
        android:id="@+id/checkDetailTextures"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Texturas Detalhadas"
        android:textColor="#FFFFFF"
        android:buttonTint="#4a9eff"
        android:layout_marginBottom="8dp"/>

    <CheckBox
        android:id="@+id/checkTexFilter2D"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Filtragem de Textura GUI"
        android:textColor="#FFFFFF"
        android:buttonTint="#4a9eff"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Limite de FPS"
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"/>

    <SeekBar
        android:id="@+id/seekFramerateLimit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="240"
        android:progress="60"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Intensidade de Tremor de Explosão"
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"/>

    <SeekBar
        android:id="@+id/seekScreenShake"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="20"
        android:progress="10"
        android:layout_marginBottom="16dp"/>

    <!-- AUDIO SETTINGS -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Áudio"
        android:textColor="#4a9eff"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"/>

    <CheckBox
        android:id="@+id/checkDisableMpDeathMusic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Desativar Música de Morte no MP"
        android:textColor="#FFFFFF"
        android:buttonTint="#4a9eff"
        android:layout_marginBottom="16dp"/>

    <!-- GAME SETTINGS -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Jogo"
        android:textColor="#4a9eff"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"/>

    <CheckBox
        android:id="@+id/checkUncapTickrate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Deslimitar Tickrate"
        android:textColor="#FFFFFF"
        android:buttonTint="#4a9eff"
        android:layout_marginBottom="8dp"/>

    <CheckBox
        android:id="@+id/checkGeMuzzleFlashes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Flash de Arma estilo GE64"
        android:textColor="#FFFFFF"
        android:buttonTint="#4a9eff"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Campo de Visão (FOV)"
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"/>

    <SeekBar
        android:id="@+id/seekFieldOfView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="170"
        android:progress="60"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Centralização do HUD"
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"/>

    <SeekBar
        android:id="@+id/seekHudCenter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="2"
        android:progress="0"
        android:layout_marginBottom="16dp"/>

    <!-- CONTROLS SETTINGS -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Controles Virtuais"
        android:textColor="#4a9eff"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"/>

    <CheckBox
        android:id="@+id/checkShowControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mostrar Controles Virtuais"
        android:textColor="#FFFFFF"
        android:buttonTint="#4a9eff"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sensibilidade do Analógico Esquerdo"
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"/>

    <SeekBar
        android:id="@+id/seekLeftStickSensitivity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:progress="50"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sensibilidade do Analógico Direito"
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"/>

    <SeekBar
        android:id="@+id/seekRightStickSensitivity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:progress="50"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Deadzone do Analógico Esquerdo"
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"/>

    <SeekBar
        android:id="@+id/seekLeftStickDeadzone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="32"
        android:progress="10"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Deadzone do Analógico Direito"
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"/>

    <SeekBar
        android:id="@+id/seekRightStickDeadzone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="32"
        android:progress="10"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Vibração"
        android:textColor="#AAAAAA"
        android:textSize="18sp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"/>

    <CheckBox
        android:id="@+id/checkVibration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Habilitar Vibração"
        android:textColor="#FFFFFF"
        android:buttonTint="#4a9eff"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Intensidade de Vibração"
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"/>

    <SeekBar
        android:id="@+id/seekVibrationStrength"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="10"
        android:progress="5"
        android:layout_marginBottom="32dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="32dp"
        android:gravity="center">

        <Button
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Salvar"
            android:layout_marginEnd="16dp"
            android:backgroundTint="#4a9eff"/>

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancelar"
            android:backgroundTint="#666666"/>

    </LinearLayout>

</LinearLayout>

</ScrollView>
