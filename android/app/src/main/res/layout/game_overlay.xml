<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="false"
    android:focusable="false">

    <!-- Controles virtuais: analógico, botões A/B/L/R/Z/Start -->
    <com.perfectdark.port.VirtualControlsView
        android:id="@+id/virtualControls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <!-- Botão de configurações (topo centro) — acima dos controles virtuais -->
    <ImageButton
        android:id="@+id/backButton"
        style="@android:style/Widget.Holo.ImageButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:alpha="0.7"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:contentDescription="Configurações"
        android:focusable="true"
        android:scaleType="centerInside"
        android:src="@android:drawable/ic_menu_more"
        android:tint="#ADFFFFFF" />

</FrameLayout>
