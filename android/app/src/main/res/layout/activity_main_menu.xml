<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Imagem de fundo cobrindo toda a tela -->
    <ImageView
        android:id="@+id/bgImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/menu_bg"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- Overlay escuro sutil para melhorar legibilidade dos botões -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#55000000" />

    <!-- Botões centralizados verticalmente, alinhados à esquerda/centro -->
    <LinearLayout
        android:id="@+id/menuContainer"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true"
        android:layout_marginStart="64dp"
        android:orientation="vertical"
        android:gravity="start">

        <!-- Botão INICIAR -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="INICIAR"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.18"
            android:textColor="#00E5FF"
            android:layout_marginBottom="12dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:strokeColor="#00E5FF"
            app:strokeWidth="2dp"
            app:cornerRadius="4dp"
            app:backgroundTint="#33000000" />

        <!-- Botão CONFIGURAÇÕES -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="CONFIGURAÇÕES"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.18"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:strokeColor="#80FFFFFF"
            app:strokeWidth="2dp"
            app:cornerRadius="4dp"
            app:backgroundTint="#33000000" />

        <!-- Botão SAIR -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExit"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="SAIR"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.18"
            android:textColor="#FF4444"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:strokeColor="#80FF4444"
            app:strokeWidth="2dp"
            app:cornerRadius="4dp"
            app:backgroundTint="#33000000" />

    </LinearLayout>

</RelativeLayout>
